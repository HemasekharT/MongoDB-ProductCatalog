# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=elegant-verbena-480615-a4
GOOGLE_APPLICATION_CREDENTIALS=/Users/hemasekhartirumalasetty/MongoDB-ProductCatalog/service-account.json
